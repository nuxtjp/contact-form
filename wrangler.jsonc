{
  // Disabled candidate: no route, enabled site, secrets, Graph identity or rate-limit binding.
  "name": "nuxtjp-contact-submissions",
  "main": "build/index.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "observability": { "enabled": false },
  "build": { "command": "worker-build --release --no-opt --no-panic-recovery" },
  "durable_objects": { "bindings": [ { "name": "RECEIPTS_NAMESPACE", "class_name": "ContactReceipts" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["ContactReceipts"] } ]
}
