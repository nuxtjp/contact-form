{
  "name": "@nuxtjp/contact-form",
  "version": "0.1.0",
  "type": "module",
  "description": "Nuxt contact form with inert native fallback and explicit guarded submission",
  "license": "Apache-2.0",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
